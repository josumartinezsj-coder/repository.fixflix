<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.fixflix" name="Repositorio FixFlix" version="1.0.0" provider-name="josumartinezsj-coder">
    <extension point="xbmc.addon.repository" name="Repositorio FixFlix">
        <dir>
            <info compressed="false">https://githubusercontent.com</info>
            <checksum>https://githubusercontent.com.md5</checksum>
            <datadir zip="true">https://githubusercontent.com</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
    </extension>
</addon>
<addon id="service.autoexec" name="Autoexec Service" version="1.0.0" provider-name="User">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="autoexec.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Autoexec Service</summary>
        <description lang="en">Ejecuta un script al iniciar Kodi.</description>
        <platform>all</platform>
    </extension>
</addon>
</addons>
